{
  "design_id": "design_5C88",
  "design_type": "fixed",
  "question": "성인 입원 환자가 살아서 퇴원하는 시각에, 퇴원 뒤 30일 안에 예정되지 않은 재입원 또는 사망이 있을지 예측한다.",
  "notes": "선택한 방법에 해당하지 않는 칸은 비워 두었다. 두 입원 기록으로 이어진 에피소드에서 특징의 범위는 각 특징의 episode 칸이 정한다. 열 값 특징은 인덱스 입원 기록의 값이다. agg가 last·first인 특징의 순서는 각 특징의 time_column 기준이다. 평가 지표의 신뢰구간은 가족(없으면 사람) 단위 부트스트랩으로 구하고, 하위 집단은 신뢰구간과 함께 보고한다 (B 병원은 표본이 적다). split.test_fraction은 묶음 수의 비율이다. 코호트는 cohort.rows_per_unit으로 행을 고른 뒤 제외 기준을 적용한다.",
  "tp": {
    "anchor": "discharge",
    "offsets_h": [
      0
    ]
  },
  "intended_use": {
    "purpose": "research_only",
    "deployment_start": "해당 없음 (전향 사용 전의 내부 검증 연구)",
    "setting": "A·B 병원의 성인 퇴원 환자 (ICU·병동), 후향 자료"
  },
  "data_source": {
    "extraction_end": "2160-01-01 00:00:00",
    "sites": [
      "A",
      "B"
    ],
    "study_period": {
      "start": "2150-01-01",
      "end": "2160-01-01"
    },
    "death_source": "linked_registry"
  },
  "outcome": {
    "name": "unplanned_readmit_or_death_30d",
    "description": "퇴원 뒤 30일 안에 같은 사람(person_id로 묶은 모든 등록 번호)의 예정되지 않은 입원이 시작되거나 사망. 결과 계산(definition=next_admission)은 창 안에 시작되는 그 사람의 입원을 모두 본다 (창 안 첫 입원 하나만 보는 것이 아니다). 예정 입원(admission_info.admission_type == elective)은 사건으로 세지 않으므로, 창 안에 예정 입원이 먼저 있어도 그 뒤 응급 입원이 있으면 양성이다. 사망은 deaths.death_time이 창 안이면 양성. 같은 에피소드 안에서 바로 이어진 입원은 재입원으로 보지 않는다 (코호트가 에피소드의 마지막 입원만 쓴다).",
    "definition": "next_admission",
    "prespecified": true,
    "definition_source": "30일 재입원 (예정 입원 제외) + 30일 안 사망을 합친 복합 결과",
    "source": "admissions",
    "scope": "patient_history",
    "time_column": "admit_time",
    "window": {
      "start": "tp",
      "end": "tp+30d"
    },
    "planned": "exclude",
    "proxies": [
      {
        "source": "admission_bookings",
        "basis": "admission_id 열은 예약 입원이 이루어진 뒤에 채워진다"
      },
      {
        "source": "outpatient_visits",
        "filter": {
          "visit_type": [
            "follow_up"
          ]
        },
        "basis": "퇴원 뒤 추적 외래는 재입원 전에만 열린다"
      }
    ],
    "ascertainment": {
      "method": "A·B 두 병원의 입원 기록과 사망 연계 자료에서 결과를 찾는다. 다른 병원 입원은 보이지 않으므로 퇴원처(자택·전원)와 병원별로 결과율을 따로 보고한다.",
      "by_stratum": [
        "discharge_status",
        "site"
      ],
      "scope": {
        "sites": [
          "A",
          "B"
        ],
        "settings": [
          "inpatient"
        ],
        "sources": [
          "admissions",
          "admission_info",
          "person_links",
          "deaths"
        ]
      },
      "min_followup": "tp+30d",
      "blind_to_predictors": true
    },
    "history": [],
    "censoring": {
      "end_of_data": "exclude_incomplete",
      "death": "composite_outcome",
      "lost_to_followup": "count_as_negative"
    },
    "pending_at_tp": "ignore",
    "match_key": "person_id",
    "planned_by": {
      "source": "admission_info",
      "filter": {
        "admission_type": [
          "elective"
        ]
      }
    }
  },
  "cohort": {
    "index_time": "tp",
    "inclusion": [
      {
        "name": "adult",
        "source": "patients",
        "column": "age",
        "agg": "value",
        "op": ">=",
        "value": 18,
        "description": "patients.age는 그 등록 번호의 첫 입원 때 나이라 인덱스 입원 때 나이는 그 이상이다"
      }
    ],
    "exclusion": [
      {
        "name": "died_in_hospital",
        "source": "admissions",
        "column": "discharge_status",
        "agg": "value",
        "op": "==",
        "value": "died"
      },
      {
        "name": "followup_incomplete",
        "description": "퇴원 뒤 30일 안 사망이 사망 연계에 모두 반영되지 않는 퇴원. 원외 사망은 사망 14~180일 뒤 기록되고 연계 반영일은 2159-07-01이므로, 2158-12-01 뒤 퇴원은 제외한다",
        "source": "admissions",
        "column": "discharge_time",
        "agg": "value",
        "op": ">",
        "value": "2158-12-01 00:00:00"
      }
    ],
    "subgroups": [
      "unit",
      "site",
      "discharge_status"
    ],
    "sampling": {
      "method": "all",
      "uses_outcome": false,
      "applies_to": "both"
    },
    "rows_per_unit": {
      "unit": "episode",
      "choose": "last"
    },
    "deduplication": {
      "key": [
        "admission_id"
      ],
      "when": "before_split"
    }
  },
  "features": [
    {
      "name": "prior_dx_chf",
      "description": "이전 입원에서 tp까지 코딩이 끝난 심부전 진단 (I50, 428) 코드 필터는 앞부분 일치 (예: N18은 N18.3, N18.4 등). 같은 사람의 다른 등록 번호를 잇는 person_id는 자료 추출 때 연결되어 tp에는 알 수 없다. 같은 에피소드의 앞 입원 진단도 tp 전에 코딩이 끝났으면 넣는다 (n_prior_adm은 입원 수라 같은 에피소드를 뺀다)",
      "source": "diagnoses",
      "filter": {
        "icd_code": [
          "I50",
          "428"
        ]
      },
      "scope": "prior_admissions",
      "time_column": "coded_time",
      "window": {
        "start": "-inf",
        "end": "tp"
      },
      "agg": "any",
      "history_key": "patient_id"
    },
    {
      "name": "cr_last",
      "source": "labs",
      "column": "value",
      "filter": {
        "test": [
          "creatinine"
        ]
      },
      "scope": "index_admission",
      "time_column": "report_time",
      "window": {
        "start": "admit",
        "end": "tp"
      },
      "agg": "last",
      "assessment": {
        "by_stratum": [
          "method"
        ],
        "method": "2155-01-01 전에 채취한 크레아티닌은 jaffe로 재어 0.10 mg/dL 높다 (데이터 설명서 labs.value). 특징을 만들 때 jaffe 값에서 0.10을 빼 enzymatic 눈금으로 맞춘 뒤 집계한다 (cr_method_align 단계)"
      },
      "description": "jaffe 값은 0.10 mg/dL을 빼서 맞춘 값으로 집계한다",
      "episode": "index_episode"
    },
    {
      "name": "n_discharge_meds",
      "source": "medications",
      "filter": {
        "med_type": [
          "discharge"
        ]
      },
      "scope": "index_admission",
      "time_column": "order_time",
      "window": {
        "start": "admit",
        "end": "tp"
      },
      "agg": "count",
      "description": "이번 퇴원(인덱스 입원)의 퇴원약만 센다. 같은 에피소드 앞 입원(전원 퇴원)의 퇴원약은 넣지 않는다"
    },
    {
      "name": "discharge_status",
      "source": "admissions",
      "column": "discharge_status",
      "scope": "index_admission",
      "agg": "value"
    },
    {
      "name": "cr_last_over_hgb",
      "derive": {
        "op": "ratio",
        "of": [
          "cr_last",
          "hgb_min"
        ]
      },
      "made_by": "leakcheck.features"
    },
    {
      "name": "problem_ckd_active",
      "description": "tp 시점 문제 목록에 활성 CKD 항목이 있음 코드 필터는 앞부분 일치 (예: N18은 N18.3, N18.4 등). 같은 사람의 다른 등록 번호를 잇는 person_id는 자료 추출 때 연결되어 tp에는 알 수 없다",
      "source": "problem_list",
      "filter": {
        "icd_code": [
          "N18"
        ],
        "status": [
          "active"
        ]
      },
      "scope": "patient_history",
      "time_column": "recorded_time",
      "window": {
        "start": "-inf",
        "end": "tp"
      },
      "as_of": "tp",
      "agg": "any",
      "history_key": "patient_id",
      "version_order": "version_then_filter"
    },
    {
      "name": "service",
      "source": "admission_info",
      "column": "service",
      "scope": "index_admission",
      "agg": "value"
    },
    {
      "name": "hgb_min",
      "source": "labs",
      "column": "value",
      "filter": {
        "test": [
          "hemoglobin"
        ]
      },
      "scope": "index_admission",
      "time_column": "report_time",
      "window": {
        "start": "admit",
        "end": "tp"
      },
      "agg": "min",
      "episode": "index_episode"
    },
    {
      "name": "age",
      "source": "patients",
      "column": "age",
      "scope": "patient",
      "agg": "value",
      "description": "patients.age는 그 등록 번호의 첫 입원 때 나이다. 인덱스 입원 때 나이 = age + (인덱스 입원 admit_time − 그 등록 번호의 첫 입원 admit_time) 연수. 데이터의 나이는 95에서 잘려 있다 (데이터 설명서 patients.age)",
      "age_reference": "index_admission"
    },
    {
      "name": "icu_any",
      "source": "transfers",
      "column": "unit",
      "filter": {
        "unit": [
          "ICU"
        ]
      },
      "scope": "index_admission",
      "time_column": "in_time",
      "window": {
        "start": "admit",
        "end": "tp"
      },
      "agg": "any",
      "episode": "index_episode"
    },
    {
      "name": "unit",
      "description": "처음 배정된 병동. 두 입원 기록으로 나뉜 에피소드에서는 마지막 입원 기록(인덱스 입원) 기준이다",
      "source": "admissions",
      "column": "unit",
      "scope": "index_admission",
      "agg": "value"
    },
    {
      "name": "site",
      "source": "admission_info",
      "column": "site",
      "scope": "index_admission",
      "agg": "value"
    },
    {
      "name": "los_h",
      "source": "admissions",
      "column": "length_of_stay_h",
      "scope": "index_admission",
      "agg": "value",
      "description": "재원 시간 = (discharge_time − admit_time) 시간. 데이터 설명서의 파생 열. 두 입원 기록으로 나뉜 에피소드에서는 마지막 입원 기록(인덱스 입원) 기준이다"
    },
    {
      "name": "sbp_last",
      "source": "vitals",
      "column": "value",
      "filter": {
        "item": [
          "sbp"
        ]
      },
      "scope": "index_admission",
      "time_column": "entered_time",
      "window": {
        "start": "tp-24h",
        "end": "tp"
      },
      "agg": "last",
      "episode": "index_episode"
    },
    {
      "name": "dialysis_ordered",
      "source": "orders",
      "filter": {
        "order_type": [
          "dialysis_order"
        ]
      },
      "scope": "index_admission",
      "time_column": "order_time",
      "window": {
        "start": "admit",
        "end": "tp"
      },
      "agg": "any",
      "episode": "index_episode"
    },
    {
      "name": "n_prior_adm",
      "source": "admissions",
      "scope": "prior_admissions",
      "time_column": "discharge_time",
      "window": {
        "start": "tp-365d",
        "end": "tp"
      },
      "agg": "count",
      "description": "같은 등록 번호의 이전 입원 수 (인덱스 입원과 같은 에피소드의 앞 입원은 빼고, 지난 365일 안에 퇴원한 것). 같은 사람의 다른 등록 번호를 잇는 person_id는 자료 추출 때 연결되어 tp에는 알 수 없다",
      "history_key": "patient_id",
      "episode": "exclude_index_episode"
    },
    {
      "name": "prior_dx_ckd",
      "description": "이전 입원에서 tp까지 코딩이 끝난 CKD 진단 (ICD-10 N18, ICD-9 585) 코드 필터는 앞부분 일치 (예: N18은 N18.3, N18.4 등). 같은 사람의 다른 등록 번호를 잇는 person_id는 자료 추출 때 연결되어 tp에는 알 수 없다. 같은 에피소드의 앞 입원 진단도 tp 전에 코딩이 끝났으면 넣는다 (n_prior_adm은 입원 수라 같은 에피소드를 뺀다)",
      "source": "diagnoses",
      "filter": {
        "icd_code": [
          "N18",
          "585"
        ]
      },
      "scope": "prior_admissions",
      "time_column": "coded_time",
      "window": {
        "start": "-inf",
        "end": "tp"
      },
      "agg": "any",
      "history_key": "patient_id"
    },
    {
      "name": "n_clinic_365d",
      "description": "tp 전 365일 안 외래 방문 수 (방문 시각 기준). 같은 사람의 다른 등록 번호를 잇는 person_id는 자료 추출 때 연결되어 tp에는 알 수 없다",
      "source": "outpatient_visits",
      "scope": "patient_history",
      "time_column": "visit_time",
      "window": {
        "start": "tp-365d",
        "end": "tp"
      },
      "agg": "count",
      "history_key": "patient_id"
    },
    {
      "name": "sex",
      "source": "patients",
      "column": "sex",
      "scope": "patient",
      "agg": "value"
    },
    {
      "name": "prior_dx_group",
      "source": "diagnoses",
      "column": "icd_code",
      "filter": {
        "seq": [
          1
        ]
      },
      "scope": "prior_admissions",
      "time_column": "coded_time",
      "window": {
        "start": "-inf",
        "end": "tp"
      },
      "agg": "last",
      "history_key": "patient_id",
      "description": "이전 입원의 주진단 코드 가운데 tp까지 코딩이 끝난 것 중 코딩이 가장 늦게 끝난 것. 범주형. 같은 사람의 다른 등록 번호를 잇는 person_id는 자료 추출 때 연결되어 tp에는 알 수 없다. ICD-9 코드는 dx_code_map 단계에서 ICD-10 코드로 바꾼 뒤 범주로 쓴다. 같은 에피소드의 앞 입원 진단도 tp 전에 코딩이 끝났으면 넣는다 (n_prior_adm은 입원 수라 같은 에피소드를 뺀다)"
    }
  ],
  "split_unit": "family",
  "split": {
    "key": "family_id",
    "fallback_key": "person_id",
    "method": "group_holdout",
    "test_fraction": 0.3,
    "seed": 20261040,
    "by_site": false
  },
  "preprocessing": [
    {
      "name": "cr_method_align",
      "kind": "transform",
      "method": "jaffe 측정 크레아티닌 값에서 0.10 mg/dL을 뺀다",
      "stateless": true,
      "applies_to": "train+test",
      "before_split": false,
      "uses_outcome": false,
      "columns": [
        "cr_last"
      ],
      "description": "columns는 이 보정이 들어가는 특징이다. 보정은 그 특징을 만들 때 labs 값 단위로(집계 전에) 한다. 0.10은 데이터 설명서(labs.value)의 고정 차이다. 결과 판정에는 쓰지 않는다 (결과 서술 참고)"
    },
    {
      "name": "median_impute",
      "kind": "impute",
      "method": "median",
      "stateless": false,
      "fit_scope": "train_fold",
      "applies_to": "train+test",
      "before_split": false,
      "uses_outcome": false,
      "columns": [
        "cr_last",
        "hgb_min",
        "sbp_last",
        "cr_last_over_hgb"
      ]
    },
    {
      "name": "dx_code_map",
      "kind": "transform",
      "method": "ICD-9 주진단 코드를 같은 병의 ICD-10 코드로 바꾼다 (데이터 설명서 diagnoses.code_system의 코드별 대응)",
      "stateless": true,
      "applies_to": "train+test",
      "before_split": false,
      "uses_outcome": false,
      "columns": [
        "prior_dx_group"
      ],
      "description": "고정 대응표를 쓴다. 코드 체계는 2155-10-01에 ICD-9에서 ICD-10으로 바뀌었다"
    },
    {
      "name": "one_hot",
      "kind": "encode",
      "method": "one_hot",
      "stateless": false,
      "fit_scope": "train_fold",
      "applies_to": "train+test",
      "before_split": false,
      "uses_outcome": false,
      "columns": [
        "sex",
        "unit",
        "discharge_status",
        "site",
        "service",
        "prior_dx_group"
      ]
    },
    {
      "name": "standardize",
      "kind": "scale",
      "method": "z_score",
      "stateless": false,
      "fit_scope": "train_fold",
      "applies_to": "train+test",
      "before_split": false,
      "uses_outcome": false,
      "columns": [
        "age",
        "los_h",
        "n_prior_adm",
        "cr_last",
        "hgb_min",
        "sbp_last",
        "n_discharge_meds",
        "cr_last_over_hgb",
        "n_clinic_365d"
      ],
      "description": "나무 모형에는 결과가 같지만 같은 입력 흐름을 유지한다"
    }
  ],
  "model": {
    "family": "gradient_boosting (결정 나무)",
    "tuning": {
      "method": "group_kfold 5폴드 (묶음 열은 cv_key, 결측이면 fallback_key)",
      "cv_key": "family_id",
      "fit_scope": "train",
      "fallback_key": "person_id"
    },
    "selection": {
      "method": "나무 깊이·학습률·나무 수 격자 탐색",
      "fit_scope": "train_fold",
      "metric": "AUROC"
