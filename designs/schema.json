{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leakage-demo/design-schema/1",
  "title": "예측 연구 설계서",
  "description": "표 형식 EHR 예측 연구의 설계서. 시각은 '기준점+간격' 문자열(tp, tp-48h, admit+24h, discharge+30d, -inf, inf). 기준점은 예측 행이 속한 입원(index admission)의 입원·퇴원 시각과 예측 시점 tp. 구간은 (start, end] 반열린 구간.",
  "type": "object",
  "required": [
    "design_id",
    "design_type",
    "tp",
    "outcome",
    "features",
    "split"
  ],
  "additionalProperties": false,
  "properties": {
    "design_id": {
      "type": "string"
    },
    "question": {
      "type": "string",
      "description": "연구 질문 (자유 서술)"
    },
    "design_type": {
      "enum": [
        "fixed",
        "dynamic"
      ],
      "description": "fixed: 입원당 예측 시점 하나 / dynamic: 입원 중 여러 랜드마크"
    },
    "tp": {
      "type": "object",
      "description": "예측 시점. anchor+offsets_h마다 예측 행 하나. anchor=admit이면 입원 중(tp < 퇴원)인 랜드마크만 예측 행이 된다.",
      "required": [
        "anchor",
        "offsets_h"
      ],
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "enum": [
            "admit",
            "discharge"
          ]
        },
        "offsets_h": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        }
      }
    },
    "outcome": {
      "type": "object",
      "required": [
        "name",
        "definition",
        "source",
        "window"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "definition": {
          "enum": [
            "kdigo_creatinine",
            "next_admission",
            "diagnosis_code"
          ],
          "description": "결과를 정하는 계산 (kdigo_creatinine: 크레아티닌 KDIGO / next_admission: 다음 입원 / diagnosis_code: 진단 코드)"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "결과를 정하는 행의 테이블"
        },
        "filter": {
          "$ref": "#/$defs/filter"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "time_column": {
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/window",
          "description": "결과 사건 창. 이 구간의 행이 결과를 정한다"
        },
        "reference_window": {
          "$ref": "#/$defs/window",
          "description": "결과 판정의 기준값(예: 기저 크레아티닌)을 읽는 구간. 결과 사건 창이 아니다"
        },
        "proxies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proxy"
          },
          "description": "결과를 정하는 과정에서 생기는 기록 (규칙표 목록에 더해짐)"
        },
        "ascertainment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "by_stratum": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "결과 확인 강도 차이를 층별로 다루는 열 (층별 보고·층화 등)"
            },
            "method": {
              "type": "string"
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "description": "결과 확인 범위: 결과 사건을 어디서 찾았나",
              "properties": {
                "sites": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "settings": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "inpatient",
                      "outpatient"
                    ]
                  }
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "결과를 찾은 테이블"
                }
              }
            },
            "min_followup": {
              "type": "string",
              "description": "결과를 확인하려면 필요한 최소 추적 (예: tp+30d)"
            },
            "blind_to_predictors": {
              "type": "boolean",
              "description": "예측변수를 모른 채 결과를 정했는가"
            }
          }
        },
        "prespecified": {
          "type": "boolean",
          "description": "결과 정의를 분석 전에 정했는가"
        },
        "definition_source": {
          "type": "string",
          "description": "결과 정의의 근거 (표준 정의 이름 등)"
        },
        "planned": {
          "enum": [
            "include",
            "exclude"
          ],
          "description": "예정(계획) 입원을 결과에 넣는가"
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "description": "결과 판정 기준값을 어디서 읽는가 (reference_window보다 자세히)",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rowset"
              },
              "description": "우선순위 순서. 앞의 출처에 값이 없으면 다음 출처"
            },
            "agg": {
              "type": "string",
              "description": "기준값 계산 (min, first 등)"
            },
            "compare_to": {
              "enum": [
                "prior_values_each",
                "fixed_baseline"
              ],
              "description": "결과 창의 각 값을 무엇과 비교하나: prior_values_each 각 값보다 먼저 잰 값 / fixed_baseline 정해진 기준값 하나"
            }
          }
        },
        "history": {
          "type": "array",
          "description": "연구 기간 중 결과 정의·측정법·코드 체계가 바뀐 이력",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "change": {
                "type": "string"
              },
              "handled": {
                "type": "string",
                "description": "분석에서 어떻게 다뤘나"
              }
            }
          }
        },
        "censoring": {
          "type": "object",
          "additionalProperties": false,
          "description": "결과 창을 끝까지 보지 못한 행",
          "properties": {
            "end_of_data": {
              "enum": [
                "exclude_incomplete",
                "count_as_negative",
                "survival_model",
                "not_applicable"
              ],
              "description": "자료 추출 종료로 결과 창이 잘린 행"
            },
            "death": {
              "enum": [
                "exclude",
                "count_as_negative",
                "composite_outcome",
                "competing_risk",
                "not_applicable"
              ],
              "description": "결과 창 안 사망"
            },
            "lost_to_followup": {
              "enum": [
                "exclude",
                "count_as_negative",
                "not_applicable"
              ],
              "description": "추적 소실"
            }
          }
        },
        "match_key": {
          "enum": [
            "patient_id",
            "person_id"
          ],
          "description": "결과 사건을 어디까지 찾나: patient_id 같은 등록 번호 / person_id 같은 사람(person_links로 묶은 모든 등록 번호)"
        },
        "planned_by": {
          "type": "object",
          "additionalProperties": false,
          "description": "예정(계획) 입원을 판정하는 테이블과 조건 (planned와 함께 쓴다)",
          "properties": {
            "source": {
              "type": "string",
              "description": "판정에 쓰는 테이블"
            },
            "filter": {
              "$ref": "#/$defs/filter"
            }
          }
        },
        "pending_at_tp": {
          "enum": [
            "exclude_row",
            "count_as_outcome",
            "ignore"
          ],
          "description": "tp 전에 생겼지만 tp에는 아직 알려지지 않은 결과 사건(예: tp 전 채취, tp 뒤 보고)의 처리: 행 제외 / 결과로 셈 / 무시"
        }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index_time": {
          "type": "string",
          "default": "tp",
          "description": "포함·제외를 정하는 기준 시점"
        },
        "inclusion": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "exclusion": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "subgroups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "결과율·확인 강도를 따로 볼 하위 집단 열"
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "description": "표본 추출 방식",
          "properties": {
            "method": {
              "enum": [
                "all",
                "random",
                "stratified",
                "case_control",
                "outcome_enriched"
              ],
              "description": "전체 / 무작위 / 층화 / 환자-대조 / 결과 기준 보강"
            },
            "by": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fraction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "대조:사례 비"
            },
            "uses_outcome": {
              "type": "boolean",
              "description": "추출에 결과를 썼는가"
            },
            "applies_to": {
              "enum": [
                "development",
                "evaluation",
                "both"
              ],
              "description": "어느 데이터에 적용했나"
            }
          }
        },
        "rows_per_unit": {
          "type": "object",
          "additionalProperties": false,
          "description": "단위마다 몇 행을 쓰나",
          "properties": {
            "unit": {
              "enum": [
                "admission",
                "episode",
                "patient",
                "person"
              ],
              "description": ""
            },
            "choose": {
              "enum": [
                "all",
                "first",
                "last",
                "random_one"
              ],
              "description": ""
            }
          }
        },
        "deduplication": {
          "type": "object",
          "additionalProperties": false,
          "description": "중복 레코드 처리",
          "properties": {
            "key": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "when": {
              "enum": [
                "before_split",
                "within_split",
                "none"
              ],
              "description": ""
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "split_unit": {
      "type": "string",
      "default": "patient",
      "description": "독립 단위: index_row < admission < episode < patient < person < family"
    },
    "split": {
      "type": "object",
      "required": [
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "description": "분할에 쓰는 묶음 열 (index_id, admission_id, patient_id, family_id)"
        },
        "method": {
          "enum": [
            "group_holdout",
            "group_kfold",
            "random_rows",
            "temporal"
          ]
        },
        "test_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "n_folds": {
          "type": "integer",
          "minimum": 2
        },
        "seed": {
          "type": "integer"
        },
        "fallback_key": {
          "type": "string",
          "description": "key가 결측인 행에 쓸 열 (예: family_id 결측이면 patient_id)"
        },
        "time_column": {
          "type": "string",
          "description": "시간 순 분할의 기준 시각 열"
        },
        "cutoff": {
          "type": "string",
          "description": "시간 순 분할 경계 시각"
        },
        "gap": {
          "type": "string",
          "description": "학습 끝과 평가 시작 사이 간격"
        },
        "by_site": {
          "type": "boolean",
          "description": "병원별로 나눴는가"
        }
      }
    },
    "preprocessing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "family": {
          "type": "string"
        },
        "tuning": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "method": {
              "type": "string"
            },
            "cv_key": {
              "type": "string",
              "description": "내부 교차검증의 묶음 열"
            },
            "fit_scope": {
              "$ref": "#/$defs/fit_scope"
            }
          }
        },
        "selection": {
          "$ref": "#/$defs/data_use",
          "description": "모형 종류·초매개변수를 고른 데이터"
        },
        "early_stopping": {
          "$ref": "#/$defs/data_use",
          "description": "조기 종료에 쓴 데이터"
        },
        "threshold": {
          "$ref": "#/$defs/data_use",
          "description": "분류 임계값을 정한 데이터"
        },
        "calibration": {
          "$ref": "#/$defs/data_use",
          "description": "보정에 쓴 데이터"
        }
      }
    },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n_designs_tried": {
          "type": "integer",
          "minimum": 0
        },
        "n_models_tried": {
          "type": "integer",
          "minimum": 0
        },
        "correction": {
          "type": "string",
          "description": "다중 시도 보정 방법 (없으면 none)"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "intended_use": {
      "type": "object",
      "additionalProperties": false,
      "description": "모형의 사용 목적",
      "properties": {
        "purpose": {
          "enum": [
            "prospective_deployment",
            "retrospective_explanation",
            "research_only"
          ],
          "description": "전향 사용 / 후향 설명 / 연구용"
        },
        "deployment_start": {
          "type": "string",
          "description": "사용을 시작할 시점 (예: 자료 추출 종료 뒤)"
        },
        "setting": {
          "type": "string",
          "description": "사용할 병원·병동"
        }
      }
    },
    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "description": "데이터 출처",
      "properties": {
        "extraction_end": {
          "type": "string",
          "description": "자료 추출 종료 시각 (데이터의 extract_info와 같은 값)"
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "사용한 병원"
        },
        "study_period": {
          "$ref": "#/$defs/period"
        },
        "death_source": {
          "enum": [
            "in_hospital_only",
            "linked_registry"
          ],
          "description": "사망 정보 출처: 원내 기록만 / 사망 연계 포함"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missing_data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "complete_case",
                "impute",
                "indicator",
                "none"
              ],
              "description": "결측 처리"
            },
            "drop_rows_when": {
              "enum": [
                "before_split",
                "after_split",
                "never"
              ],
              "description": "결측 행을 지우는 시점"
            },
            "outcome_missing": {
              "enum": [
                "exclude",
                "count_as_negative",
                "not_applicable"
              ],
              "description": "결과가 결측인 행"
            }
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "description": "성능 평가",
      "properties": {
        "data": {
          "enum": [
            "test",
            "cv",
            "validation",
            "train",
            "all"
          ],
          "description": "성능을 계산한 데이터"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_set_uses": {
          "type": "integer",
          "minimum": 0,
          "description": "평가 부분으로 성능을 본 횟수"
        },
        "subgroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "calibration_reported": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "filter": {
      "type": "object",
      "description": "열 → 허용 값 목록. 코드 열(icd_code, code)은 앞부분 일치",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "scope": {
      "enum": [
        "patient",
        "index_admission",
        "prior_admissions",
        "next_admission",
        "patient_history"
      ],
      "description": "행을 어느 입원에서 가져오나. patient: 환자 정적 정보 / index_admission: 이번 입원 / prior_admissions: 이번 입원 전에 퇴원한 입원 / next_admission: 다음 입원 / patient_history: 그 환자의 모든 입원(미래 포함, 창으로 제한)"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "default": "-inf"
        },
        "end": {
          "type": "string",
          "default": "inf"
        }
      }
    },
    "fit_scope": {
      "enum": [
        "train",
        "train_fold",
        "validation",
        "all",
        "train+test",
        "test"
      ],
      "description": "추정·결정에 쓴 데이터. train: 학습 부분 / train_fold: 교차검증 학습 폴드 / validation: 학습 부분에서 떼어 둔 검증 부분 / all: 분할 전 전체 / train+test / test: 평가 부분"
    },
    "rowset": {
      "type": "object",
      "description": "원본 테이블에서 행을 고르고(필터·범위·창) 집계하는 명세. 특징과 포함·제외 기준이 같이 쓴다",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "원본 테이블. 없으면 출처 불명"
        },
        "column": {
          "type": "string",
          "description": "값 열 (없으면 테이블 기본 값 열)"
        },
        "filter": {
          "$ref": "#/$defs/filter"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "time_column": {
          "type": "string",
          "description": "창을 적용할 시각 열"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "agg": {
          "enum": [
            "value",
            "last",
            "first",
            "max",
            "min",
            "mean",
            "count",
            "any",
            "kdigo_aki",
            "delta",
            "range",
            "slope"
          ]
        },
        "made_by": {
          "type": "string",
          "default": "leakcheck.features",
          "description": "다른 값이면 출처 불명"
        },
        "fit_scope": {
          "$ref": "#/$defs/fit_scope",
          "description": "특징 계산에 데이터에서 추정한 값을 쓰면 그 범위"
        },
        "date_compare": {
          "enum": [
            "day_end",
            "day_start",
            "same_date_ok"
          ],
          "description": "날짜만 있는 시각을 tp와 비교하는 규칙: 그날 23:59로 봄 / 그날 00:00으로 봄 / 날짜끼리 비교(date <= date(tp))"
        },
        "as_of": {
          "enum": [
            "tp",
            "latest"
          ],
          "description": "수정 이력이 있는 기록을 어느 시점 내용으로 읽나: tp 시점에 있던 버전 / 최종본"
        },
        "derive": {
          "type": "object",
          "additionalProperties": false,
          "description": "다른 특징·값으로 만든 파생 특징",
          "properties": {
            "op": {
              "enum": [
                "ratio",
                "difference",
                "sum",
                "product"
              ],
              "description": ""
            },
            "of": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "쓰인 특징 이름 (순서대로)"
            }
          }
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "description": "측정 방식이 집단마다 다른가",
          "properties": {
            "by_stratum": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "method": {
              "type": "string"
            }
          }
        },
        "episode": {
          "enum": [
            "index_admission",
            "index_episode",
            "exclude_index_episode"
          ],
          "description": "이어진 입원(같은 episode_id) 처리: index_admission 이번 입원 기록만 / index_episode 같은 에피소드의 tp까지 모든 입원 기록 / exclude_index_episode 같은 에피소드의 입원을 뺌 (이전 입원 집계용)"
        },
        "history_key": {
          "enum": [
            "patient_id",
            "person_id"
          ],
          "description": "환자 단위 범위(patient, prior_admissions, patient_history)의 행을 무엇으로 묶나: 같은 등록 번호 / 같은 사람"
        },
        "version_order": {
          "enum": [
            "version_then_filter",
            "filter_then_version"
          ],
          "description": "as_of로 버전을 고르는 것과 filter를 거는 것의 순서: 버전을 먼저 고른 뒤 거름 / 거른 뒤 버전을 고름"
        },
        "age_reference": {
          "enum": [
            "first_admission_of_id",
            "index_admission"
          ],
          "description": "patients.age를 어느 시점 나이로 쓰나: 그 등록 번호의 첫 입원 때 값 그대로 / 인덱스 입원 때 나이 (age + 첫 입원부터 경과 연수)"
        }
      }
    },
    "feature": {
      "$ref": "#/$defs/rowset",
      "required": [
        "name"
      ],
      "unevaluatedProperties": false
    },
    "criterion": {
      "$ref": "#/$defs/rowset",
      "required": [
        "name",
        "op",
        "value"
      ],
      "properties": {
        "op": {
          "enum": [
            "==",
            "!=",
            ">=",
            ">",
            "<=",
            "<",
            "in",
            "not_in"
          ]
        },
        "value": {}
      },
      "unevaluatedProperties": false
    },
    "proxy": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "filter": {
          "$ref": "#/$defs/filter"
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "impute, scale, clip, select, encode, resample, reduce, transform 등"
        },
        "stateless": {
          "type": "boolean",
          "default": false,
          "description": "데이터에서 아무것도 추정하지 않는 단계 (예: 로그 변환)"
        },
        "fit_scope": {
          "$ref": "#/$defs/fit_scope"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "type": "string",
          "description": "방법. impute: median / mean / constant / forward_fill / backward_fill / interpolate, encode: one_hot / target, resample: oversample / undersample / smote 등"
        },
        "applies_to": {
          "$ref": "#/$defs/fit_scope",
          "description": "적용한 데이터 (fit_scope는 추정에 쓴 데이터)"
        },
        "before_split": {
          "type": "boolean",
          "description": "분할 전에 했는가"
        },
        "uses_outcome": {
          "type": "boolean",
          "description": "결과값을 썼는가"
        }
      }
    },
    "data_use": {
      "type": "object",
      "additionalProperties": false,
      "description": "모형을 고르거나 정하는 단계 하나에 무엇을 썼는가",
      "properties": {
        "method": {
          "type": "string"
        },
        "fit_scope": {
          "$ref": "#/$defs/fit_scope"
        },
        "metric": {
          "type": "string",
          "description": "고를 때 본 지표"
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    }
  }
}
