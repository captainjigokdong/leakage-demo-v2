{
  "design_id": "prereview_fixed_readmission",
  "design_type": "fixed",
  "question": "성인 입원 환자가 살아서 퇴원하는 시각에, 퇴원 뒤 30일 안에 예정되지 않은 재입원 또는 사망이 있을지 예측한다.",
  "notes": "2단계 2b 예비 검수용 깨끗한 기본 설계서. 선택한 방법에 해당하지 않는 칸은 비워 두었다: outcome.filter, outcome.reference_window, outcome.reference (다음 입원으로 정하는 결과라 기준값이 없음), cohort.sampling.by, cohort.sampling.fraction, cohort.sampling.ratio (전체 사용), split.n_folds, split.time_column, split.cutoff, split.gap (가족 단위 무작위 분할), features의 date_compare (날짜만 있는 열을 쓰지 않음).",
  "tp": {
    "anchor": "discharge",
    "offsets_h": [0]
  },
  "intended_use": {
    "purpose": "prospective_deployment",
    "deployment_start": "자료 추출 종료(2160-01-01) 뒤",
    "setting": "A·B 병원의 성인 퇴원 환자 (ICU·병동)"
  },
  "data_source": {
    "extraction_end": "2160-01-01 00:00:00",
    "sites": ["A", "B"],
    "study_period": {"start": "2150-01-01", "end": "2160-01-01"},
    "death_source": "linked_registry"
  },
  "outcome": {
    "name": "unplanned_readmit_or_death_30d",
    "description": "퇴원 뒤 30일 안에 같은 환자의 예정되지 않은 입원(응급 입원)이 시작되거나 사망. 같은 에피소드 안에서 바로 이어진 입원은 재입원으로 보지 않는다 (코호트가 에피소드의 마지막 입원만 쓴다).",
    "definition": "next_admission",
    "prespecified": true,
    "definition_source": "30일 재입원 (예정 입원 제외) + 30일 안 사망을 합친 복합 결과",
    "source": "admissions",
    "scope": "next_admission",
    "time_column": "admit_time",
    "window": {"start": "tp", "end": "tp+30d"},
    "planned": "exclude",
    "proxies": [
      {"source": "admission_bookings",
       "basis": "admission_id 열은 예약 입원이 이루어진 뒤에 채워진다. 특징으로 쓰지 않는다"},
      {"source": "outpatient_visits", "filter": {"visit_type": ["follow_up"]},
       "basis": "퇴원 뒤 추적 외래는 재입원 전에만 열린다. 특징으로 쓰지 않는다"}
    ],
    "ascertainment": {
      "method": "A·B 두 병원의 입원 기록과 사망 연계 자료에서 결과를 찾는다. 다른 병원 입원은 보이지 않으므로 퇴원처(자택·전원)와 병원별로 결과율을 따로 보고한다.",
      "by_stratum": ["discharge_status", "site"],
      "scope": {
        "sites": ["A", "B"],
        "settings": ["inpatient"],
        "sources": ["admissions", "admission_info", "deaths"]
      },
      "min_followup": "tp+30d",
      "blind_to_predictors": true
    },
    "history": [],
    "censoring": {
      "end_of_data": "exclude_incomplete",
      "death": "composite_outcome",
      "lost_to_followup": "count_as_negative"
    }
  },
  "cohort": {
    "index_time": "tp",
    "inclusion": [
      {"name": "adult", "source": "patients", "column": "age", "agg": "value", "op": ">=", "value": 18}
    ],
    "exclusion": [
      {"name": "died_in_hospital", "source": "admissions", "column": "discharge_status", "agg": "value",
       "op": "==", "value": "died"},
      {"name": "followup_incomplete", "description": "퇴원 뒤 30일이 사망 연계 반영일(2159-07-01) 안에 들지 않는 퇴원",
       "source": "admissions", "column": "discharge_time", "agg": "value", "op": ">", "value": "2159-06-01 00:00:00"}
    ],
    "subgroups": ["unit", "site", "discharge_status"],
    "sampling": {"method": "all", "uses_outcome": false, "applies_to": "both"},
    "rows_per_unit": {"unit": "episode", "choose": "last"},
    "deduplication": {"key": ["admission_id"], "when": "before_split"}
  },
  "features": [
    {"name": "age", "source": "patients", "column": "age", "scope": "patient", "agg": "value"},
    {"name": "sex", "source": "patients", "column": "sex", "scope": "patient", "agg": "value"},
    {"name": "unit", "description": "처음 배정된 병동", "source": "admissions", "column": "unit",
     "scope": "index_admission", "agg": "value"},
    {"name": "icu_any", "source": "transfers", "column": "unit", "filter": {"unit": ["ICU"]},
     "scope": "index_admission", "time_column": "in_time", "window": {"start": "admit", "end": "tp"}, "agg": "any"},
    {"name": "los_h", "source": "admissions", "column": "length_of_stay_h", "scope": "index_admission", "agg": "value"},
    {"name": "discharge_status", "source": "admissions", "column": "discharge_status", "scope": "index_admission",
     "agg": "value"},
    {"name": "site", "source": "admission_info", "column": "site", "scope": "index_admission", "agg": "value"},
    {"name": "service", "source": "admission_info", "column": "service", "scope": "index_admission", "agg": "value"},
    {"name": "n_prior_adm", "source": "admissions", "scope": "prior_admissions", "time_column": "discharge_time",
     "window": {"start": "tp-365d", "end": "tp"}, "agg": "count"},
    {"name": "prior_dx_ckd", "description": "이전 입원에서 tp까지 코딩이 끝난 CKD 진단 (ICD-10 N18, ICD-9 585)",
     "source": "diagnoses", "filter": {"icd_code": ["N18", "585"]}, "scope": "prior_admissions",
     "time_column": "coded_time", "window": {"start": "-inf", "end": "tp"}, "agg": "any"},
    {"name": "prior_dx_chf", "description": "이전 입원에서 tp까지 코딩이 끝난 심부전 진단 (I50, 428)",
     "source": "diagnoses", "filter": {"icd_code": ["I50", "428"]}, "scope": "prior_admissions",
     "time_column": "coded_time", "window": {"start": "-inf", "end": "tp"}, "agg": "any"},
    {"name": "problem_ckd_active", "description": "tp 시점 문제 목록에 활성 CKD 항목이 있음",
     "source": "problem_list", "filter": {"icd_code": ["N18"], "status": ["active"]}, "scope": "patient_history",
     "time_column": "recorded_time", "window": {"start": "-inf", "end": "tp"}, "as_of": "tp", "agg": "any"},
    {"name": "cr_last", "source": "labs", "column": "value", "filter": {"test": ["creatinine"]},
     "scope": "index_admission", "time_column": "report_time", "window": {"start": "admit", "end": "tp"},
     "agg": "last",
     "assessment": {"by_stratum": ["method"], "method": "2155-01-01 전은 jaffe(약 0.10 mg/dL 높음), 뒤는 enzymatic. 측정법을 함께 넣는다"}},
    {"name": "cr_method", "source": "labs", "column": "method", "filter": {"test": ["creatinine"]},
     "scope": "index_admission", "time_column": "report_time", "window": {"start": "admit", "end": "tp"},
     "agg": "last"},
    {"name": "hgb_min", "source": "labs", "column": "value", "filter": {"test": ["hemoglobin"]},
     "scope": "index_admission", "time_column": "report_time", "window": {"start": "admit", "end": "tp"},
     "agg": "min"},
    {"name": "sbp_last", "source": "vitals", "column": "value", "filter": {"item": ["sbp"]},
     "scope": "index_admission", "time_column": "entered_time", "window": {"start": "tp-24h", "end": "tp"},
     "agg": "last"},
    {"name": "n_discharge_meds", "source": "medications", "filter": {"med_type": ["discharge"]},
     "scope": "index_admission", "time_column": "order_time", "window": {"start": "admit", "end": "tp"},
     "agg": "count"},
    {"name": "dialysis_ordered", "source": "orders", "filter": {"order_type": ["dialysis_order"]},
     "scope": "index_admission", "time_column": "order_time", "window": {"start": "admit", "end": "tp"},
     "agg": "any"},
    {"name": "cr_last_over_hgb", "derive": {"op": "ratio", "of": ["cr_last", "hgb_min"]},
     "made_by": "leakcheck.features"}
  ],
  "split_unit": "family",
  "split": {
    "key": "family_id",
    "fallback_key": "patient_id",
    "method": "group_holdout",
    "test_fraction": 0.3,
    "seed": 20261040,
    "by_site": false
  },
  "preprocessing": [
    {"name": "median_impute", "kind": "impute", "method": "median", "stateless": false, "fit_scope": "train",
     "applies_to": "train+test", "before_split": false, "uses_outcome": false,
     "columns": ["cr_last", "hgb_min", "sbp_last", "cr_last_over_hgb"]},
    {"name": "one_hot", "kind": "encode", "method": "one_hot", "stateless": false, "fit_scope": "train",
     "applies_to": "train+test", "before_split": false, "uses_outcome": false,
     "columns": ["sex", "unit", "discharge_status", "site", "service", "cr_method"]},
    {"name": "standardize", "kind": "scale", "method": "z_score", "stateless": false, "fit_scope": "train",
     "applies_to": "train+test", "before_split": false, "uses_outcome": false,
     "columns": ["age", "los_h", "n_prior_adm", "cr_last", "hgb_min", "sbp_last", "n_discharge_meds",
                 "cr_last_over_hgb"]}
  ],
  "model": {
    "family": "logistic_regression",
    "tuning": {"method": "group_kfold", "cv_key": "family_id", "fit_scope": "train"},
    "selection": {"method": "규제 강도 C 격자 탐색", "fit_scope": "train_fold", "metric": "AUROC"},
    "early_stopping": {"method": "사용하지 않음 (로지스틱 회귀)"},
    "threshold": {"method": "학습 부분 교차검증 예측에서 민감도 0.8이 되는 값", "fit_scope": "train_fold",
                  "metric": "sensitivity"},
    "calibration": {"method": "학습 부분 교차검증 예측으로 Platt 보정", "fit_scope": "train_fold",
                    "metric": "calibration slope"}
  },
  "analysis": {
    "missing_data": {"method": "impute", "drop_rows_when": "never", "outcome_missing": "not_applicable"}
  },
  "evaluation": {
    "data": "test",
    "metrics": ["AUROC", "AUPRC", "Brier", "calibration slope"],
    "test_set_uses": 1,
    "subgroups": ["unit", "site", "discharge_status"],
    "calibration_reported": true
  },
  "attempts": {"n_designs_tried": 1, "n_models_tried": 1, "correction": "none"}
}
