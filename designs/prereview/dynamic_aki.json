      "stateless": false,
      "fit_scope": "train_fold",
      "applies_to": "train+test",
      "before_split": false,
      "uses_outcome": false,
      "columns": [
        "age",
        "cr_last",
        "cr_min_adm",
        "cr_max_48h",
        "n_cr",
        "cr_rise",
        "bun_last",
        "k_last",
        "hgb_min",
        "sbp_min_24h",
