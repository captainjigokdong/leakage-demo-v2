  ],
  "model": {
    "family": "logistic_regression",
    "tuning": {
      "method": "group_kfold (family_id, 없으면 person_id)",
      "cv_key": "family_id",
      "fit_scope": "train",
      "fallback_key": "person_id"
    },
    "selection": {
      "method": "규제 강도 C 격자 탐색",
      "fit_scope": "train_fold",
      "metric": "AUROC"
    },
    "early_stopping": {
