    "ascertainment": {
      "method": "입원 중 채혈한 크레아티닌으로만 판정한다. 병동은 ICU보다 채혈이 드물어 결과가 덜 잡히므로 머문 병동별로 측정 빈도와 결과율을 따로 보고하고, 이를 한계로 적는다. 병동 채혈 빈도는 연구 기간 동안 늘어나므로(데이터 설명서), 층마다 측정 빈도와 결과율의 연도별 추이도 함께 보고한다. 결과 판정은 규칙 코드(KDIGO)로 하고 예측값을 보지 않는다. KDIGO의 기준값은 정의상 이전 크레아티닌이다. 창 안 퇴원 비율도 병동별로 보고한다",
      "by_stratum": [
        "unit_at_tp"
      ],
      "scope": {
        "sites": [
          "A",
          "B"
        ],
        "settings": [
          "inpatient"
        ],
        "sources": [
          "labs",
          "admissions"
        ]
      },
      "min_followup": "tp (원내 사건으로 정의, outcome.description 참고)",
      "blind_to_predictors": true
    },
